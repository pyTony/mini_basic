1 REM dialect: bbc
    10 REM Spinning soccer ball (Accurate Archimedes / Matrix Brandy Port)
    20 MODE 9
    25 *REFRESH OFF
    30 VDU 23,1,0;0;0;0;: REM Hide cursor
    40 ORIGIN 640,512
    50 REM Set background to Green (Palette 2 in Mode 9)
    60 VDU 19,0,2,0,0,0
    70 CLS
    75 VDU 19,1,P,0,0,0
    80 DIM XYZ(2,59), TMP(2,59), B(2,2), C(2,2), M(2,2)
    90 S = SQR(5) + 1: P = S / 2: Q = P + 2: R_VAL = S + 1: T = P * 3
   100 FOR I% = 0 TO 59
   110   READ XYZ(0,I%), XYZ(1,I%), XYZ(2,I%)
   120 NEXT I%
   130 B = 0.5: C = 0.0
   140 REM Matrix B (Rotation around Y)
   150 B(0,0) = COS(B): B(0,1) = 0: B(0,2) = -SIN(B)
   160 B(1,0) = 0: B(1,1) = 1: B(1,2) = 0
   170 B(2,0) = SIN(B): B(2,1) = 0: B(2,2) = COS(B)
   180 REPEAT
   190   REM Matrix C (Rotation around Z)
   200   C(0,0) = COS(C): C(0,1) = SIN(C): C(0,2) = 0
   210   C(1,0) = -SIN(C): C(1,1) = COS(C): C(1,2) = 0
   220   C(2,0) = 0: C(2,1) = 0: C(2,2) = 1
   230   REM Combined matrix M = B . C (exact order matching BBCSDL)
   240   FOR R% = 0 TO 2
   250     FOR C% = 0 TO 2
   260       M(R%,C%) = B(R%,0) * C(0,C%) + B(R%,1) * C(1,C%) + B(R%,2) * C(2,C%)
   270     NEXT C%
   280   NEXT R%
   290   REM TMP = M . XYZ
   300   FOR I% = 0 TO 59
   310     TMP(0,I%) = M(0,0) * XYZ(0,I%) + M(0,1) * XYZ(1,I%) + M(0,2) * XYZ(2,I%)
   320     TMP(1,I%) = M(1,0) * XYZ(0,I%) + M(1,1) * XYZ(1,I%) + M(1,2) * XYZ(2,I%)
   330     TMP(2,I%) = M(2,0) * XYZ(0,I%) + M(2,1) * XYZ(1,I%) + M(2,2) * XYZ(2,I%)
   340   NEXT I%
   350   CLS
   360   REM Draw Yellow Ball Base (Color 3 = Yellow in Mode 9)
   370   GCOL 0, 3
   380   CIRCLE FILL 0, 0, 432
   390   REM Draw Black Patches (Color 0 = Black in Mode 9)
   400   GCOL 0, 1
   410   I% = 0
   420   FOR J% = 0 TO 11
   430     Z = TMP(1,I%) + TMP(1,I%+1) + TMP(1,I%+2) + TMP(1,I%+3) + TMP(1,I%+4)
   440     FOR K% = 0 TO 4
   450       X% = 3200 * TMP(0,I%) / (36 + TMP(1,I%))
   460       Y% = 3200 * TMP(2,I%) / (36 + TMP(1,I%))
   470       IF K% < 2 THEN
   480         MOVE X%, Y%
   490       ELSE
   500         IF Z < -2.5 THEN PLOT 85, X%, Y%
   510       ENDIF
   520       I% = I% + 1
   530     NEXT K%
   540   NEXT J%
   545   *REFRESH
   550   WAIT
   560   C = C + 0.03
   570 UNTIL FALSE
   580 END
   590 DATA 0, 1, 4.85410, -1.61803, 2, 4.23606, 1.61803, 2, 4.23606, -1, 3.61803, 3.23606, 1, 3.61803, 3.23606
   600 DATA 0, 1, -4.85410, -1.61803, 2, -4.23606, 1.61803, 2, -4.23606, -1, 3.61803, -3.23606, 1, 3.61803, -3.23606
   610 DATA 0, -1, 4.85410, -1.61803, -2, 4.23606, 1.61803, -2, 4.23606, -1, -3.61803, 3.23606, 1, -3.61803, 3.23606
   620 DATA 0, -1, -4.85410, -1.61803, -2, -4.23606, 1.61803, -2, -4.23606, -1, -3.61803, -3.23606, 1, -3.61803, -3.23606
   630 DATA 1, 4.85410, 0, 2, 4.23606, -1.61803, 2, 4.23606, 1.61803, 3.61803, 3.23606, -1, 3.61803, 3.23606, 1
   640 DATA 1, -4.85410, 0, 2, -4.23606, -1.61803, 2, -4.23606, 1.61803, 3.61803, -3.23606, -1, 3.61803, -3.23606, 1
