10 REM Life benchmark 32x24, 5 generations (GW-BASIC / PC-BASIC)
15 T=TIMER
16 MAXG=5
40 W=32
50 H=24
60 DIM L(32,24), N(32,24)
90 FOR I=1 TO W
100  FOR J=1 TO H
110   IF RND(1)>=.7 THEN N(I,J)=1 ELSE N(I,J)=0
120  NEXT J
130 NEXT I
240 G=0
280 FOR J=1 TO H
290  R$=""
300  FOR I=1 TO W
310   C=N(I,J): L(I,J)=C
320   IF C THEN R$=R$+"*" ELSE R$=R$+" "
330  NEXT I
340  PRINT R$
345 NEXT J
350 FOR I=1 TO W
360  FOR J=1 TO H
370  C=0
380  FOR K=I-1 TO I+1
390   IF K=0 OR K>W THEN 440
400   FOR M=J-1 TO J+1
410    IF M=0 OR M>H OR (K=I AND M=J) THEN 430
420    C=C+L(K,M)
430   NEXT M
440  NEXT K
450  IF C=2 THEN N(I,J)=L(I,J) ELSE IF C=3 THEN N(I,J)=1 ELSE N(I,J)=0
460 NEXT J
470 NEXT I
480 G=G+1
485 IF G>=MAXG THEN 495
490 GOTO 280
495 PRINT TIMER-T
496 END