10 DIM RN$(20),RD$(20),EX(20,4)
20 DIM OB$(30),OD$(30),OL(30),TK(30)
30 GOSUB 4000
40 R=1
50 PRINT "THE EDITABLE ADVENTURE"
60 PRINT "TYPE HELP FOR A LIST OF COMMANDS."
70 GOSUB 1000
80 GOTO 500
500 INPUT ">";C$
510 GOSUB 3000
520 IF V$="QUIT" OR V$="Q" THEN PRINT "GOODBYE.":END
530 IF V$="LOOK" OR V$="L" THEN GOSUB 1000:GOTO 500
540 IF V$="N" OR V$="NORTH" THEN D=1:GOSUB 1200:GOTO 500
550 IF V$="S" OR V$="SOUTH" THEN D=2:GOSUB 1200:GOTO 500
560 IF V$="E" OR V$="EAST" THEN D=3:GOSUB 1200:GOTO 500
570 IF V$="W" OR V$="WEST" THEN D=4:GOSUB 1200:GOTO 500
580 IF V$="GO" THEN V$=N$:GOTO 540
590 IF V$="TAKE" OR V$="GET" THEN GOSUB 1400:GOTO 500
600 IF V$="DROP" THEN GOSUB 1600:GOTO 500
610 IF V$="INVENTORY" OR V$="I" THEN GOSUB 1800:GOTO 500
620 IF V$="EXAMINE" OR V$="X" THEN GOSUB 2000:GOTO 500
630 IF V$="HELP" OR V$="H" THEN GOSUB 2200:GOTO 500
640 PRINT "I DO NOT UNDERSTAND THAT COMMAND."
650 GOTO 500
1000 PRINT
1010 PRINT RN$(R)
1020 PRINT RD$(R)
1030 F=0
1040 FOR J=1 TO OC
1050 IF OL(J)=R THEN PRINT "YOU SEE ";OB$(J);CHR$(32);"HERE.":F=1
1060 NEXT J
1070 PRINT "EXITS: ";
1080 IF EX(R,1)>0 THEN PRINT "NORTH ";
1090 IF EX(R,2)>0 THEN PRINT "SOUTH ";
1100 IF EX(R,3)>0 THEN PRINT "EAST ";
1110 IF EX(R,4)>0 THEN PRINT "WEST ";
1120 PRINT
1130 RETURN
1200 NR=EX(R,D)
1210 IF NR=0 THEN PRINT "YOU CANNOT GO THAT WAY.":RETURN
1220 R=NR
1230 GOSUB 1000
1240 RETURN
1400 IF N$="" THEN PRINT "TAKE WHAT?":RETURN
1410 F=0
1420 FOR J=1 TO OC
1430 IF OL(J)=R AND OB$(J)=N$ THEN F=J
1440 NEXT J
1450 IF F=0 THEN PRINT "THAT IS NOT HERE.":RETURN
1460 IF TK(F)=0 THEN PRINT "YOU CANNOT TAKE THE ";OB$(F);".":RETURN
1470 OL(F)=0
1480 PRINT "TAKEN."
1490 RETURN
1600 IF N$="" THEN PRINT "DROP WHAT?":RETURN
1610 F=0
1620 FOR J=1 TO OC
1630 IF OL(J)=0 AND OB$(J)=N$ THEN F=J
1640 NEXT J
1650 IF F=0 THEN PRINT "YOU ARE NOT CARRYING THAT.":RETURN
1660 OL(F)=R
1670 PRINT "DROPPED."
1680 RETURN
1800 F=0
1810 PRINT "YOU ARE CARRYING:"
1820 FOR J=1 TO OC
1830 IF OL(J)=0 THEN PRINT CHR$(32);CHR$(32);OB$(J):F=1
1840 NEXT J
1850 IF F=0 THEN PRINT CHR$(32);CHR$(32);"NOTHING"
1860 RETURN
2000 IF N$="" THEN PRINT "EXAMINE WHAT?":RETURN
2010 F=0
2020 FOR J=1 TO OC
2030 IF (OL(J)=R OR OL(J)=0) AND OB$(J)=N$ THEN F=J
2040 NEXT J
2050 IF F=0 THEN PRINT "YOU CANNOT SEE THAT HERE.":RETURN
2060 PRINT OD$(F)
2070 RETURN
2200 PRINT "COMMANDS:"
2210 PRINT "  NORTH SOUTH EAST WEST"
2220 PRINT "  GO direction"
2230 PRINT "  LOOK"
2240 PRINT "  TAKE object"
2250 PRINT "  DROP object"
2260 PRINT "  EXAMINE object"
2270 PRINT "  INVENTORY"
2280 PRINT "  HELP"
2290 PRINT "  QUIT"
2300 PRINT "COMMANDS AND OBJECT NAMES MUST BE UPPERCASE."
2310 RETURN
3000 V$=C$:N$=""
3010 L=LEN(C$)
3020 FOR P=1 TO L
3030 IF MID$(C$,P,1)=CHR$(32) AND N$="" THEN V$=LEFT$(C$,P-1):N$=MID$(C$,P+1):P=L
3040 NEXT P
3050 RETURN
4000 OPEN 1,"rooms.txt","INPUT"
4010 INPUT#1,RC
4020 FOR J=1 TO RC
4030 INPUT#1,RN$(J),RD$(J),EX(J,1),EX(J,2),EX(J,3),EX(J,4)
4040 NEXT J
4050 CLOSE 1
4060 OPEN 1,"objects.txt","INPUT"
4070 INPUT#1,OC
4080 FOR J=1 TO OC
4090 INPUT#1,OB$(J),OD$(J),OL(J),TK(J)
4100 NEXT J
4110 CLOSE 1
4120 RETURN
