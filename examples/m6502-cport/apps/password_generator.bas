10 X=RND(-1)
20 PRINT "PASSWORD GENERATOR"
30 PRINT "DEMONSTRATION ONLY - NOT FOR SECURITY-CRITICAL PASSWORDS."
100 INPUT "PASSWORD LENGTH (4-40)";L
110 IF L<>INT(L) OR L<4 OR L>40 THEN PRINT "ENTER A WHOLE NUMBER FROM 4 TO 40.":GOTO 100
120 INPUT "INCLUDE SYMBOLS (Y/N)";S$
130 IF S$="y" THEN S$="Y"
140 IF S$="n" THEN S$="N"
150 IF S$<>"Y" AND S$<>"N" THEN PRINT "PLEASE ANSWER Y OR N.":GOTO 120
160 C$="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
170 IF S$="Y" THEN C$=C$+"!@#$%&*+-=?"
180 P$=""
190 FOR I=1 TO L
200 X=RND(1)
210 N=INT(X*LEN(C$))+1
220 P$=P$+MID$(C$,N,1)
230 NEXT I
240 PRINT "PASSWORD: ";P$
250 INPUT "GENERATE ANOTHER (Y/N)";A$
260 IF A$="y" THEN A$="Y"
270 IF A$="n" THEN A$="N"
280 IF A$="Y" THEN X=RND(1):GOTO 100
290 IF A$<>"N" THEN PRINT "PLEASE ANSWER Y OR N.":GOTO 250
300 PRINT "DONE."
310 END
