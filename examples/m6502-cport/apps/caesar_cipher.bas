10 PRINT "CAESAR CIPHER TOOL"
20 PRINT "LETTER CASE AND NON-LETTERS ARE PRESERVED."
100 INPUT "ENCODE, DECODE, OR QUIT";O$
110 T$=O$:GOSUB 1000:O$=T$
120 IF O$="QUIT" OR O$="Q" THEN GOTO 500
130 IF O$<>"ENCODE" AND O$<>"E" AND O$<>"DECODE" AND O$<>"D" THEN GOTO 450
140 INPUT "TEXT";P$
150 INPUT "SHIFT (0-25)";S
160 IF S<>INT(S) OR S<0 OR S>25 THEN PRINT "ENTER A WHOLE NUMBER FROM 0 TO 25.":GOTO 150
170 K=S
180 IF O$="DECODE" OR O$="D" THEN K=26-S
190 GOSUB 2000
200 PRINT "RESULT: ";R$
210 GOTO 100
450 PRINT "PLEASE ENTER ENCODE, DECODE, OR QUIT."
460 GOTO 100
500 PRINT "GOODBYE."
510 END
1000 R$=""
1010 FOR J=1 TO LEN(T$)
1020 A=ASC(MID$(T$,J,1))
1030 IF A>=97 AND A<=122 THEN A=A-32
1040 R$=R$+CHR$(A)
1050 NEXT J
1060 T$=R$
1070 RETURN
2000 R$=""
2010 FOR J=1 TO LEN(P$)
2020 A=ASC(MID$(P$,J,1))
2030 IF A>=65 AND A<=90 THEN X=A-65+K:X=X-INT(X/26)*26:R$=R$+CHR$(65+X):GOTO 2070
2040 IF A>=97 AND A<=122 THEN X=A-97+K:X=X-INT(X/26)*26:R$=R$+CHR$(97+X):GOTO 2070
2050 R$=R$+CHR$(A)
2070 NEXT J
2080 RETURN
