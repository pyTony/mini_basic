10 X=RND(-1)
20 PW=0:CW=0:TI=0
30 PRINT "ROCK-PAPER-SCISSORS"
40 PRINT "ENTER ROCK, PAPER, SCISSORS, OR QUIT."
100 INPUT "YOUR CHOICE";P$
110 T$=P$:GOSUB 1000:P$=T$
120 IF P$="QUIT" OR P$="Q" THEN GOTO 500
130 P=0
140 IF P$="ROCK" THEN P=1
150 IF P$="PAPER" THEN P=2
160 IF P$="SCISSORS" THEN P=3
170 IF P=0 THEN PRINT "PLEASE CHOOSE ROCK, PAPER, OR SCISSORS.":GOTO 100
180 C=INT(X*3)+1
190 IF C=1 THEN C$="ROCK"
200 IF C=2 THEN C$="PAPER"
210 IF C=3 THEN C$="SCISSORS"
220 PRINT "YOU CHOSE ";P$;"."
230 PRINT "COMPUTER CHOSE ";C$;"."
240 IF P=C THEN TI=TI+1:PRINT "IT IS A TIE.":GOTO 300
250 W=0
260 IF P=1 AND C=3 THEN W=1
270 IF P=2 AND C=1 THEN W=1
280 IF P=3 AND C=2 THEN W=1
290 IF W=1 THEN PW=PW+1:PRINT "YOU WIN!"
295 IF W=0 THEN CW=CW+1:PRINT "COMPUTER WINS."
300 PRINT "SCORE - YOU:";PW;" COMPUTER:";CW;" TIES:";TI
310 INPUT "PLAY AGAIN (Y/N)";A$
320 T$=A$:GOSUB 1000:A$=T$
330 IF A$="Y" OR A$="YES" THEN X=RND(1):GOTO 100
340 IF A$<>"N" AND A$<>"NO" THEN PRINT "PLEASE ANSWER Y OR N.":GOTO 310
500 PRINT "FINAL SCORE - YOU:";PW;" COMPUTER:";CW;" TIES:";TI
510 PRINT "THANKS FOR PLAYING."
520 END
1000 R$=""
1010 FOR J=1 TO LEN(T$)
1020 A=ASC(MID$(T$,J,1))
1030 IF A>=97 AND A<=122 THEN A=A-32
1040 R$=R$+CHR$(A)
1050 NEXT J
1060 T$=R$
1070 RETURN
