10 X=RND(-1)
20 GOSUB 1000
30 PRINT "HANGMAN"
40 PRINT "GUESS THE WORD BEFORE THE DRAWING IS COMPLETE."
100 GOSUB 2000
110 GOSUB 3000
120 IF C=1 THEN GOTO 800
130 IF M=6 THEN GOTO 850
140 PRINT "USED LETTERS: ";U$
150 INPUT "GUESS A LETTER";G$
160 IF LEN(G$)<>1 THEN PRINT "ENTER ONE LETTER.":GOTO 100
165 Z=ASC(G$):IF Z>=97 AND Z<=122 THEN G$=CHR$(Z-32)
170 F=0
180 FOR J=1 TO LEN(U$)
190 IF MID$(U$,J,1)=G$ THEN F=1
200 NEXT J
210 IF F=1 THEN PRINT "YOU ALREADY GUESSED THAT LETTER.":GOTO 100
220 U$=U$+G$
230 F=0
240 FOR J=1 TO LEN(W$)
250 IF MID$(W$,J,1)=G$ THEN F=1
260 NEXT J
270 IF F=0 THEN M=M+1:PRINT "THAT LETTER IS NOT IN THE WORD."
280 GOTO 100
800 PRINT "YOU WON! THE WORD WAS ";W$;"."
810 GOTO 900
850 GOSUB 2000
860 PRINT "YOU LOST. THE WORD WAS ";W$;"."
900 INPUT "PLAY AGAIN (Y/N)";A$
905 IF A$="y" THEN A$="Y"
907 IF A$="n" THEN A$="N"
910 IF A$="Y" THEN X=RND(1):GOSUB 1000:GOTO 30
920 PRINT "THANKS FOR PLAYING."
930 END
1000 N=INT(X*50)+1
1010 RESTORE
1020 FOR J=1 TO N
1030 READ W$
1040 NEXT J
1050 U$="":M=0
1060 RETURN
2000 PRINT
2010 PRINT "+---+"
2020 PRINT "|   |"
2030 IF M=0 THEN PRINT "|"
2040 IF M>0 THEN PRINT "|   O"
2050 IF M<2 THEN PRINT "|"
2060 IF M=2 THEN PRINT "|   |"
2070 IF M=3 THEN PRINT "|  /|"
2080 IF M>3 THEN PRINT "|  /|\"
2090 IF M<5 THEN PRINT "|"
2100 IF M=5 THEN PRINT "|  /"
2110 IF M>5 THEN PRINT "|  / \"
2120 PRINT "|"
2130 PRINT "======="
2140 RETURN
3000 D$="":C=1
3010 FOR J=1 TO LEN(W$)
3020 L$=MID$(W$,J,1):F=0
3030 FOR K=1 TO LEN(U$)
3040 IF MID$(U$,K,1)=L$ THEN F=1
3050 NEXT K
3060 IF F=1 THEN D$=D$+L$
3070 IF F=0 THEN D$=D$+"_":C=0
3080 NEXT J
3090 PRINT "WORD: ";
3100 FOR J=1 TO LEN(D$)
3110 PRINT MID$(D$,J,1);CHR$(32);
3120 NEXT J
3130 PRINT
3140 PRINT "MISSES: ";M;" OF 6"
3150 RETURN
5000 DATA APPLE,BAKER,CANDY,DELTA,EAGLE
5010 DATA FLAME,GRAPE,HOUSE,IVORY,JOKER
