10 X=RND(-1)
20 PRINT "NUMBER GUESSING GAME"
30 PRINT "I AM THINKING OF A NUMBER FROM 1 TO 100."
40 N=INT(X*100)+1
50 G=0
60 INPUT "YOUR GUESS";Q
70 IF Q<1 OR Q>100 THEN PRINT "ENTER A NUMBER FROM 1 TO 100.":GOTO 60
80 G=G+1
90 IF Q<N THEN PRINT "TOO LOW.":GOTO 60
100 IF Q>N THEN PRINT "TOO HIGH.":GOTO 60
110 PRINT "CORRECT! YOU GUESSED IT IN";G;"TRIES."
120 INPUT "PLAY AGAIN (Y/N)";A$
130 IF A$="Y" THEN X=RND(1):GOTO 40
140 PRINT "THANKS FOR PLAYING."
150 END
