flowchart TD
    A["python -m mini_basic"] --> B["mini_basic/__main__.py"]
    B --> C["Import package; expose main()"]
    C --> D["runtime.main()"]
    D --> E["Parse CLI args and environment<br/>Build InterpreterConfig"]

    E --> F{"Help or version?"}
    F -- Yes --> G["Print requested info; exit"]
    F -- No --> H["Optional startup banner"]
    H --> I["Apply debug config"]
    I --> J["Create BASICInterpreter(config)<br/>Set program args / trace"]

    J --> K{"Listing mode requested?"}
    K -- "Yes, no file" --> L["Switch to interactive REPL"]
    K -- "Yes, with file" --> M{"Target is a .bas program?"}
    M -- No --> N["Print listing-mode error; exit"]
    M -- Yes --> O["Load program and list it"]
    O --> P{"Continue interactively (-i)?"}
    P -- No --> Q["Exit with status"]
    P -- Yes --> L
    K -- No --> R{"-c / --command supplied?"}

    R -- Yes --> S["Split command text into REPL lines"]
    S --> T["Execute command lines"]
    T --> U{"Interactive mode (-i)?"}
    U -- Yes --> L
    U -- No --> V["Exit"]

    R -- No --> W{"Target file supplied?"}
    W -- Yes --> X{"Classify target"}
    X -- ".mbs / .cmd / stdin marker" --> Y["Read and execute REPL command script"]
    X -- ".bas or program-like file" --> Z["Load BASIC program"]
    Z --> AA["Run program<br/>Prepare dialect/display; execute lines"]
    AA --> AB["Handle stop/errors; flush output;<br/>close resources and restore console"]
    Y --> AC{"Interactive mode (-i)?"}
    AB --> AD{"Interactive mode (-i)?"}
    AC -- Yes --> L
    AC -- No --> V
    AD -- Yes --> L
    AD -- No --> AE["Return status<br/>(pygame may hold display open)"]

    W -- No --> AF{"stdin is a TTY?"}
    AF -- No --> AG["Read piped stdin and execute as command session"]
    AF -- Yes --> L

    L --> AH["Interactive REPL loop"]
    AH --> AI["Prompt; read input; dispatch REPL/BASIC commands"]
    AI --> AH
    AI --> AJ["Exit command / EOF"]
